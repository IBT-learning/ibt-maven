pipeline {
    agent any

    stages {
    stage('Git Checkout') {
     steps{
       checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/feature-davido']], extensions: [], userRemoteConfigs: [[credentialsId: 'GitHub-login-credential', url: 'https://github.com/IBT-learning/ibt-maven.git']])
     }
    }

    stage ('Validate'){
     steps{
        withMaven(maven: 'maven_3.8') {
          bat 'mvn validate'
        }
     }
    }
    stage ('Compile'){
      steps{
         withMaven(maven: 'maven_3.8') {
         bat 'mvn compile'
         }
      }
    }
    stage ('test run'){
        steps{
           withMaven(maven: 'maven_3.8') {
           bat 'mvn test'
         }
       }
      }
      stage ('SonarQube Analysis') {
        environment{
            sonarScan = tool 'july-sonarqube'
            }
            steps{
              withSonarQubeEnv(credentialsId: 'sonarqube-credential', installationName: 'July-sonarqube') {
                  bat "$sonarScan/bin/sonar-scanner"
                }
              }
          }
          stage ('Package'){
                  steps{
                     withMaven(maven: 'maven_3.8') {
                     bat 'mvn package'
                 }
              }
          }

           stage ('Upload to Artifactory'){
                            steps{
                               withCredentials([file(credentialsId: 'maven-settings1', variable: 'mvn-settings')]) {
                                  withMaven(maven: 'maven_3.8') {
                                       bat 'mvn deploy -s $mvn_settings'
                             }
                        }
                    }
          }
          stage ('Upload to Artifactory- configfile'){
                                      steps{
                                         configFileProvider([configFile(fileId: 'maven-settings', targetLocation: 'mvn_settings_config', variable: 'mvn_settings_config')]) {
                                            withMaven(maven: 'maven_3.8') {
                                                 bat 'mvn deploy -s $mvn_settings_config'
                                       }
                                  }
                              }

          }
          stage ('Deploy to Dev'){
                                                steps{
                                                   script{
                                                     def remote = [name: 'ubuntu-s-1vcpu-1gb-lon1-01', host: '159.65.63.137', allowAnyHosts: true]
                                                 withCredentials([usernamePassword(credentialsId: 'server-ssh-pw', passwordVariable: 'password', usernameVariable: 'username')]) {
                                                              remote.user = username
                                                              remote.password = password
                                                              sshPut remote: remote, from: 'target/ibt-maven-1.0-SNAPSHOT.JAR',into: '/opt/tomcat/apps'
                                                 }
                                            }
                                        }

          }
      }
  }
