pipeline {
    agent any

    tools {
            maven 'Maven_3.8.9' // Assuming you have a Maven installation named 'Maven_3.8.9' configured in Jenkins
        }

    stages {
    stage{'Git Checkout'} {
     steps{
       checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/feature-david']], extensions: [], userRemoteConfigs: [[credentialsId: 'GitHub-login-credential', url: 'https://github.com/IBT-learning/ibt-maven.git']])
       }
    }

    stage ('Validate'){
     steps{
        withMaven(maven: 'maven_3.8.9') {
        bat 'mvn validate'
        }
     }
    }
    stage ('Compile'){
      steps{
         withMaven(maven: 'maven_3.8.9') {
         bat 'mvn compile'
         }
      }
    }
    stage ('test run'){
        steps{
           withMaven(maven: 'maven_3.8.9') {
           bat 'mvn test'
         }
     }
    }
}