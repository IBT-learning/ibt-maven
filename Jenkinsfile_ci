pipeline {
agent any
tools {
  maven 'maven_3.9'
}
stages {
 stage{'Git Checkout'} {
     steps{
       checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/feature-david']], extensions: [], userRemoteConfigs: [[credentialsId: 'GitHub-login-credential', url: 'https://github.com/IBT-learning/ibt-maven.git']])
     }
 }

 stage ('Validate'){
     steps{
        withMaven(maven: 'maven_3.9') {
        bat 'mvn validate'
        }
     }
 }
 stage ('Compile'){
      steps{
         withMaven(maven: 'maven_3.9') {
         bat 'mvn compile'
         }
      }
  }
  stage ('test run'){
        steps{
           withMaven(maven: 'maven_3.9') {
           bat 'mvn test'
        }
    }
 }
}