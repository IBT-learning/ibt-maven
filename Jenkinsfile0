pipeline {
    agent any
    parameters{
      string(name:'Branch_Name', defaultValue:'main', description:'Enter the branch to checkout')
      choice(name:'CHOICES', choices: ['one', 'two', 'three'], description: 'chose a number')
    }
    stages {
        stage('Hello') {
            steps {
                echo 'Hello World'
            }
        }
        stage('Hi') {
            steps {
                echo 'Hi Mike'
            }
        }
        stage('Hiya') {
            steps {
                echo 'Hi Chichi Man'
            }
        }
        stage('testing jenkins') {
             steps {
                 echo 'jenkins'
             }
         }
        stage('Git checkout'){
            steps{
                checkout changelog: false, poll: false, scm: scmGit(branches: [[name: '*/$Branch_Name']], extensions: [], userRemoteConfigs: [[credentialsId: 'mike_db_connection', url: 'https://github.com/IBT-learning/ibt-maven.git']])
                dir 'echo $Branch_Name $CHOICES'
            }
        }
    }
}
